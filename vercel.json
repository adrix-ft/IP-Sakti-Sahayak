{
  "version": 2,
  "builds": [
    {
      "src": "frontend/package.json",
      "use": "@vercel/vite"
    },
    {
      "src": "backend/fastapi_app.py",
      "use": "@vercel/python"
    }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "/backend/fastapi_app.py" },
    { "src": "/(.*)", "dest": "/frontend/dist/$1" }
  ]
}
